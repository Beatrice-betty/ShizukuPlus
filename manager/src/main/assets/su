#!/system/bin/sh

# Shizuku+ SU Bridge (su wrapper)
# POSIX / Magisk / SuperSU Compatible

BASEDIR=$(dirname "$0")

# Unset dynamic linker preload to avoid EACCES in cross-UID ADB mode
unset LD_PRELOAD

COMMAND=""
HAS_COMMAND=0
PRESERVE_ENV=1

# Helper function to single-quote escape an argument safely for /system/bin/sh
escape_arg() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

while [ $# -gt 0 ]; do
    case "$1" in
        -v|--version)
            echo "26.4:MAGISKSU"
            exit 0
            ;;
        -V)
            echo "26400"
            exit 0
            ;;
        -h|--help)
            echo "usage: su [options] [-] [user [argument...]]"
            echo ""
            echo "Options:"
            echo "  -c, --command <command>  pass command to shell"
            echo "  -p, -m, --preserve-environment"
            echo "                           preserve environment"
            echo "  -s, --shell <shell>      specify shell"
            echo "  -l, --login              simulate a login shell"
            echo "  -v, --version            display version number and exit"
            echo "  -V                       display version code and exit"
            echo "  -M, -mm, --mount-master  run in global mount namespace"
            exit 0
            ;;
        -p|-m|--preserve-environment)
            PRESERVE_ENV=1
            shift
            ;;
        -l|--login|-)
            PRESERVE_ENV=0
            shift
            ;;
        -s|--shell)
            shift 2
            ;;
        --shell=*)
            shift
            ;;
        -z|-Z|--context)
            shift 2
            ;;
        --context=*)
            shift
            ;;
        -M|-mm|--mount-master)
            shift
            ;;
        -c|--command)
            shift
            if [ $# -eq 1 ]; then
                COMMAND="$1"
            elif [ $# -gt 1 ]; then
                COMMAND=""
                for arg in "$@"; do
                    if [ -z "$COMMAND" ]; then
                        COMMAND="$(escape_arg "$arg")"
                    else
                        COMMAND="$COMMAND $(escape_arg "$arg")"
                    fi
                done
            fi
            HAS_COMMAND=1
            break
            ;;
        --command=*)
            COMMAND="${1#--command=}"
            HAS_COMMAND=1
            shift
            break
            ;;
        --)
            shift
            if [ $# -gt 0 ]; then
                COMMAND=""
                for arg in "$@"; do
                    if [ -z "$COMMAND" ]; then
                        COMMAND="$(escape_arg "$arg")"
                    else
                        COMMAND="$COMMAND $(escape_arg "$arg")"
                    fi
                done
                HAS_COMMAND=1
            fi
            break
            ;;
        *)
            # Check if this token is a username/UID (0, root, shell, etc.)
            case "$1" in
                0|root|shell|1000|[0-9]*)
                    shift
                    # If arguments remain after user specifier, they form the command
                    if [ $# -gt 0 ]; then
                        COMMAND=""
                        for arg in "$@"; do
                            if [ -z "$COMMAND" ]; then
                                COMMAND="$(escape_arg "$arg")"
                            else
                                COMMAND="$COMMAND $(escape_arg "$arg")"
                            fi
                        done
                        HAS_COMMAND=1
                        break
                    fi
                    ;;
                *)
                    # Direct positional command: su id
                    COMMAND=""
                    for arg in "$@"; do
                        if [ -z "$COMMAND" ]; then
                            COMMAND="$(escape_arg "$arg")"
                        else
                            COMMAND="$COMMAND $(escape_arg "$arg")"
                        fi
                    done
                    HAS_COMMAND=1
                    break
                    ;;
            esac
            ;;
    esac
done

export RISH_PRESERVE_ENV="$PRESERVE_ENV"

if [ "$HAS_COMMAND" = "1" ] && [ -n "$COMMAND" ]; then
    exec sh "$BASEDIR/rish" -c "$COMMAND"
else
    exec sh "$BASEDIR/rish"
fi
